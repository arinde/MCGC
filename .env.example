# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real keys.

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# The SERVICE ROLE key, not the anon key. Server-side only; it bypasses RLS.
# If this ever leaks, rotate it in Supabase immediately.


# ---- Dashboard ----
# The shared password for /admin. Make it long. Changing it signs everyone out.
ADMIN_PASSWORD="change-this-to-something-long"

# ---- Site ----
# The real public URL. Used for share cards and the sitemap — must be right at launch.
PUBLIC_SITE_URL="https://mcgc-convention.netlify.app"

