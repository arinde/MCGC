---
import Base from "../layouts/Base.astro";
import { convention } from "../data/convention";

import SiteNav from "../components/home/SiteNav.astro";
import Hero from "../components/home/Hero.astro";
import FactsStrip from "../components/home/FactsStrip.astro";
import About from "../components/home/About.astro";
import Schedule from "../components/home/Schedule.astro";
import Ministers from "../components/home/Ministers.astro";
import Flyers from "../components/home/Flyers.astro";
import CampChecklist from "../components/home/CampChecklist.astro";
import Register from "../components/home/Register.astro";
import Venue from "../components/home/Venue.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import Reveal from "../components/Reveal.astro";

const pageTitle = `${convention.title} ${convention.year} — ${convention.theme.join(" ")}`;
---

<Base title={pageTitle}>
  <SiteNav />
  <Hero />

  <main id="main">
    <FactsStrip />
    <About />
    <Schedule />
    <Ministers />
    <Flyers />
    <CampChecklist />
    <Register />
    <Venue />
  </main>

  <SiteFooter />
  <Reveal />
</Base>
