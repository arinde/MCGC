---
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import { checkPassword, createSession } from "../../lib/auth";
import { logActivity } from "../../lib/supabase";

// Reads a submitted password and sets a cookie — must run on the server.
export const prerender = false;

const nextPath = Astro.url.searchParams.get("next") ?? "/admin";
// Only ever redirect within this site — an open redirect here would let an
// attacker use the login page to bounce people to a lookalike.
const safeNext = nextPath.startsWith("/") && !nextPath.startsWith("//") ? nextPath : "/admin";

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = String(form.get("password") ?? "");

  if (checkPassword(password)) {
    await createSession(Astro.cookies);
    await logActivity("login", "Signed in to the dashboard");
    return Astro.redirect(safeNext, 302);
  }

  error = "That password isn’t right.";
}
---

<Base title="Sign in · MCGC Admin" noindex>
  <main id="main" class="login">
    <form class="login__card" method="POST">
      <p class="eyebrow">MCGC Convention</p>
      <h1 class="display login__title">Dashboard</h1>
      <p class="login__hint">Enter the shared admin password.</p>

      <label for="password" class="sr-only">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autocomplete="current-password"
        placeholder="Password"
        required
        autofocus
      />

      {error && <p class="login__error" role="alert">{error}</p>}

      <Button type="submit" class="login__submit">Sign in</Button>
    </form>
  </main>
</Base>

<style>
  .login {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: var(--space-6);
  }

  .login__card {
    width: 100%;
    max-width: 380px;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    padding: 34px;
  }

  .login__title {
    font-size: 2.2rem;
    margin: 12px 0 6px;
  }

  .login__hint {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 22px;
  }

  .login__card input {
    width: 100%;
    background: var(--surface-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    padding: 13px 15px;
  }

  .login__card input:focus {
    border-color: var(--accent);
    outline: none;
  }

  .login__error {
    color: var(--color-danger);
    font-size: 0.85rem;
    margin: 12px 0 0;
  }

  .login__card :global(.login__submit) {
    width: 100%;
    margin-top: 18px;
  }
</style>
