---
import Admin from "../../layouts/Admin.astro";
import StatTile from "../../components/admin/StatTile.astro";
import DayTable from "../../components/admin/DayTable.astro";
import Panel from "../../components/admin/Panel.astro";
import LineChart from "../../components/admin/LineChart.astro";
import BarChart from "../../components/admin/BarChart.astro";
import DonutChart from "../../components/admin/DonutChart.astro";
import NeedsPanel from "../../components/admin/NeedsPanel.astro";
import ActivityFeed from "../../components/admin/ActivityFeed.astro";
import { loadDashboard, type DashboardData } from "../../lib/stats";
import { teamName } from "../../lib/volunteers";
import { isConfigured } from "../../lib/supabase";

// Live figures — never prerender.
export const prerender = false;

let data: DashboardData | null = null;
let loadError = "";

if (!isConfigured()) {
  loadError = "Supabase isn’t configured yet. Add SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to your .env.";
} else {
  try {
    data = await loadDashboard();
  } catch (error) {
    console.error("[dashboard] load failed:", error);
    loadError = "Couldn’t reach the database. Check the credentials and that schema.sql has been run.";
  }
}

const decimal = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 1 });
---

<Admin title="Overview" active="overview">
  {
    loadError ? (
      <div class="notice">
        <h1 class="notice__title">Not connected yet</h1>
        <p>{loadError}</p>
        <p class="notice__hint">See <code>README.md</code> → “Setting up the database”.</p>
      </div>
    ) : (
      data && (
        <>
          <div class="page-head">
            <div>
              <p class="eyebrow">Live</p>
              <h1 class="page-head__title">Convention overview</h1>
            </div>
            <p class="page-head__meta">
              <span class="dot" aria-hidden="true" />
              {data.totals.registeredToday} signed up today · refreshes every 30s
            </p>
          </div>

          <div class="tiles">
            <StatTile
              label="People expected"
              value={data.totals.people}
              detail={`across ${data.totals.parties} bookings`}
              feature
            />
            <StatTile
              label="Checked in"
              value={data.totals.checkedInTotal}
              detail="all nights so far"
            />
            <StatTile
              label="Average party"
              value={decimal.format(data.totals.averageParty)}
              detail="people per booking"
            />
            <StatTile
              label="Busiest night"
              value={data.totals.peakNight?.label ?? "—"}
              detail={`${data.totals.peakNight?.registeredPeople ?? 0} expected`}
            />
            <StatTile
              label="This week"
              value={data.totals.registeredThisWeek}
              detail="new bookings"
            />
            <StatTile label="Branches" value={data.totals.branchCount} detail="represented" />
            <StatTile
              label="Volunteers"
              value={data.volunteers.total}
              detail={`${data.volunteers.byTeam.length} teams covered`}
            />
            <StatTile
              label="First-timers"
              value={data.totals.firstTimers}
              detail="for follow-up"
            />
          </div>

          <div class="grid">
            <Panel
              title="How sign-ups have built"
              hint="Total people expected, accumulating day by day. A flat stretch means a quiet week."
              wide
            >
              <LineChart
                labels={data.timeline.map((point) => point.label)}
                values={data.timeline.map((point) => point.cumulativePeople)}
                caption="Cumulative people expected, by the day they registered"
              />
            </Panel>

            <Panel
              title="Registered against actual"
              hint="What each night was promised, next to who really walked through the gate."
              wide
            >
              <BarChart
                groups={data.days.map((day) => ({
                  label: day.label.replace("Day ", "D"),
                  values: [day.registeredPeople, day.attendedPeople],
                }))}
                series={["Registered", "Attended"]}
                caption="People registered and people checked in, for each night of the convention"
              />
            </Panel>

            <NeedsPanel flags={data.flags} totalParties={data.totals.parties} />

            <Panel title="Party sizes" hint="How many people arrive together.">
              <DonutChart
                slices={data.partySizes}
                totalLabel="bookings"
                caption="Bookings split by how many people are in the party"
              />
            </Panel>

            <Panel title="Where they're coming from" hint="Top branches by people expected.">
              <DonutChart
                slices={data.branches.map((branch) => ({
                  label: branch.branch,
                  value: branch.people,
                  href: `/admin/people?branch=${encodeURIComponent(branch.branch)}`,
                }))}
                totalLabel="people"
                caption="People expected, split by branch"
              />
            </Panel>

            <Panel title="Volunteer teams" hint="Sign-ups per team. Click a team to see the names.">
              <DonutChart
                slices={data.volunteers.byTeam.map((team) => ({
                  label: teamName(team.label),
                  value: team.value,
                  href: `/admin/volunteers?team=${encodeURIComponent(team.label)}`,
                }))}
                totalLabel="volunteers"
                caption="Volunteers signed up, split by team"
              />
            </Panel>

            {data.checkinFlow.points.length > 0 && (
              <Panel
                title={`Gate flow — ${data.checkinFlow.day}`}
                hint="People checked in each hour on the busiest night. This is how you staff the gate."
                wide
              >
                <LineChart
                  labels={data.checkinFlow.points.map((point) => point.label)}
                  values={data.checkinFlow.points.map((point) => point.people)}
                  caption={`People checked in per hour on ${data.checkinFlow.day}`}
                />
              </Panel>
            )}
          </div>

          <div class="stack">
            <DayTable days={data.days} />

            <Panel title="Latest registrations" hint="The twelve most recent. The register has everyone.">
            <a slot="action" class="action" href="/admin/people">Open the register →</a>

            {data.recent.length === 0 ? (
              <p class="empty">Nothing yet — the first registration will appear here.</p>
            ) : (
              <div class="table-scroll">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th scope="col">Name</th>
                      <th scope="col">Phone</th>
                      <th scope="col">Branch</th>
                      <th scope="col" class="num">Party</th>
                      <th scope="col">Nights</th>
                      <th scope="col">Code</th>
                    </tr>
                  </thead>
                  <tbody>
                    {data.recent.map((registration) => (
                      <tr>
                        <th scope="row">
                          {registration.name}
                          {registration.flags.length > 0 && (
                            <span class="sub">{registration.flags.join(" · ")}</span>
                          )}
                        </th>
                        <td data-label="Phone">
                          <a href={`tel:${registration.phone}`}>{registration.phone}</a>
                        </td>
                        <td data-label="Branch">{registration.branch ?? "—"}</td>
                        <td data-label="Party" class="num">{registration.party_size}</td>
                        <td data-label="Nights">{registration.days.join(", ") || "—"}</td>
                        <td data-label="Code"><code>{registration.code}</code></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </Panel>

            <ActivityFeed activity={data.activity} />
          </div>
        </>
      )
    )
  }
</Admin>

<script>
  // The dashboard is watched during the convention, so keep it current without
  // the user thinking about it. Pauses in a background tab to save data.
  const REFRESH_MS = 30_000;
  let timer: ReturnType<typeof setTimeout>;

  const schedule = () => {
    clearTimeout(timer);
    if (document.hidden) return;
    timer = setTimeout(() => location.reload(), REFRESH_MS);
  };

  document.addEventListener("visibilitychange", schedule);
  schedule();
</script>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .eyebrow {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }

  .page-head__title {
    font-size: var(--text-lg);
    font-weight: 800;
    margin: var(--space-1) 0 0;
  }

  .page-head__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-success);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }

  .tiles {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin-bottom: var(--space-6);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  /* DayTable and the panels beneath it each own their internal padding, so
     the rhythm between them comes from one gap rather than stacked margins. */
  .stack {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .stack {
      gap: var(--space-6);
    }
  }

  .action {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-info);
    text-decoration: none;
    white-space: nowrap;
  }

  .action:hover {
    text-decoration: underline;
  }

  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }

  .notice {
    background: var(--surface);
    border: 1px solid var(--accent-deep);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    max-width: 60ch;
  }

  .notice__title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 var(--space-3);
  }

  .notice p {
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }

  .notice__hint {
    font-size: 0.86rem;
  }
</style>
