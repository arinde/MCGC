---
import Admin from "../../layouts/Admin.astro";
import { convention, currentDayLabel } from "../../data/convention";
import { getSupabase, isConfigured } from "../../lib/supabase";

// Reflects check-ins made seconds ago — never prerender.
export const prerender = false;

const today = currentDayLabel();
const selectedDay = Astro.url.searchParams.get("day") ?? today;

let checkedInCount = 0;
let ready = isConfigured();

if (ready) {
  try {
    const { count } = await getSupabase()
      .from("checkins")
      .select("id", { count: "exact", head: true })
      .eq("day_label", selectedDay);
    checkedInCount = count ?? 0;
  } catch {
    ready = false;
  }
}
---

<Admin title="Check-in" active="checkin">
  <div class="page-head">
    <div>
      <p class="eyebrow">At the door</p>
      <h1 class="display page-head__title">Check-in</h1>
    </div>
    <p class="page-head__meta"><b id="checked-count">{checkedInCount}</b> checked in tonight</p>
  </div>

  {
    !ready ? (
      <p class="empty">Connect the database first — see the Overview tab.</p>
    ) : (
      <>
        <div class="day-picker" role="group" aria-label="Which night">
          {convention.days.map((day) => (
            <a
              href={`/admin/checkin?day=${encodeURIComponent(day.label)}`}
              class:list={["day", day.label === selectedDay && "day--active"]}
            >
              {day.label}
              {day.label === today && <small>tonight</small>}
            </a>
          ))}
        </div>

        <div class="search">
          <label for="q" class="sr-only">Search by name, phone or code</label>
          <input
            type="search"
            id="q"
            placeholder="Type a name, phone number or code…"
            autocomplete="off"
            autofocus
            data-day={selectedDay}
          />
          <p class="search__hint" id="search-hint">
            Start typing — results appear as you go.
          </p>
        </div>

        <ul class="results" id="results"></ul>
      </>
    )
  }
</Admin>

<script>
  const input = document.getElementById("q") as HTMLInputElement | null;
  const results = document.getElementById("results");
  const hint = document.getElementById("search-hint");
  const counter = document.getElementById("checked-count");

  if (input && results && hint) {
    const day = input.dataset.day!;
    let debounce: ReturnType<typeof setTimeout>;
    let latestQuery = 0;

    type Match = {
      id: string;
      name: string;
      phone: string;
      branch: string | null;
      code: string;
      party_size: number;
      guest_names?: string[];
      checked_in: boolean;
    };

    /**
     * Everything below is written into innerHTML, and every value in a match
     * came from a public form. A registration saved under the name
     * `<img src=x onerror=...>` would otherwise run in the usher's signed-in
     * admin session the moment anyone searched for it.
     */
    const escapeHtml = (value: string) =>
      value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const render = (matches: Match[]) => {
      results.innerHTML = matches
        .map(
          (match) => `
        <li class="result${match.checked_in ? " result--done" : ""}">
          <div>
            <p class="result__name">${escapeHtml(match.name)}</p>
            <p class="result__meta">${escapeHtml(match.phone)}${match.branch ? " · " + escapeHtml(match.branch) : ""} · party of ${match.party_size} · <code>${escapeHtml(match.code)}</code></p>
            ${
              match.guest_names?.length
                ? `<p class="result__guests">With: ${match.guest_names
                    .map((guest) => escapeHtml(guest))
                    .join(", ")}</p>`
                : ""
            }
          </div>
          ${
            match.checked_in
              ? '<span class="result__done">Checked in</span>'
              : `<button type="button" class="result__btn" data-id="${match.id}" data-size="${match.party_size}">Check in</button>`
          }
        </li>`,
        )
        .join("");
    };

    const search = async (query: string) => {
      const token = ++latestQuery;
      const response = await fetch(
        `/api/search?q=${encodeURIComponent(query)}&day=${encodeURIComponent(day)}`,
      );
      const matches: Match[] = await response.json();

      // A slower earlier request must not overwrite a faster later one.
      if (token !== latestQuery) return;

      hint.textContent = matches.length ? `${matches.length} found` : "Nobody matches that.";
      render(matches);
    };

    input.addEventListener("input", () => {
      clearTimeout(debounce);
      const query = input.value.trim();

      if (query.length < 2) {
        results.innerHTML = "";
        hint.textContent = "Start typing — results appear as you go.";
        return;
      }

      debounce = setTimeout(() => search(query), 180);
    });

    results.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".result__btn");
      if (!button) return;

      button.disabled = true;
      button.textContent = "…";

      try {
        const response = await fetch("/api/checkin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            registrationId: button.dataset.id,
            dayLabel: day,
            partySize: Number(button.dataset.size),
          }),
        });

        if (!response.ok) throw new Error("failed");

        const row = button.closest(".result")!;
        row.classList.add("result--done");
        button.replaceWith(
          Object.assign(document.createElement("span"), {
            className: "result__done",
            textContent: "Checked in",
          }),
        );

        if (counter) counter.textContent = String(Number(counter.textContent) + 1);
      } catch {
        button.disabled = false;
        button.textContent = "Try again";
      }
    });
  }
</script>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }

  .page-head__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-top: var(--space-1);
  }

  .page-head__meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .page-head__meta b {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .day-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .day {
    border: 1px solid var(--rule-strong);
    color: var(--text-muted);
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .day small {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .day--active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--surface-deep);
  }

  .day--active small {
    color: var(--surface-deep);
  }

  .search input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    color: var(--text);
    font-family: inherit;
    font-size: 1.15rem;
    padding: 18px 20px;
  }

  .search input:focus {
    border-color: var(--accent);
    outline: none;
  }

  .search__hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 10px 0 20px;
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .results :global(.result) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 16px 18px;
  }

  .results :global(.result--done) {
    border-color: var(--color-success);
    opacity: 0.75;
  }

  .results :global(.result__name) {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .results :global(.result__meta) {
    margin: 4px 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .results :global(code) {
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .results :global(.result__guests) {
    font-size: 0.8rem;
    color: var(--text);
    margin: 4px 0 0;
  }

  .results :global(.result__btn) {
    flex: 1 0 auto;
    min-height: 48px;
    background: var(--accent);
    color: var(--surface-deep);
    border: 0;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 12px 22px;
    cursor: pointer;
    white-space: nowrap;
  }

  .results :global(.result__btn[disabled]) {
    opacity: 0.6;
  }

  .results :global(.result__done) {
    color: var(--color-success);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
