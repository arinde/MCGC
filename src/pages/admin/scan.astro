---
import Admin from "../../layouts/Admin.astro";
import { convention, currentDayLabel } from "../../data/convention";
import { getSupabase, isConfigured } from "../../lib/supabase";

// Live counts and check-ins.
export const prerender = false;

const today = currentDayLabel();
const selectedDay = Astro.url.searchParams.get("day") ?? today;

let checkedInCount = 0;
let ready = isConfigured();

if (ready) {
  try {
    const { count } = await getSupabase()
      .from("checkins")
      .select("id", { count: "exact", head: true })
      .eq("day_label", selectedDay);
    checkedInCount = count ?? 0;
  } catch {
    ready = false;
  }
}
---

<Admin title="Scan" active="scan">
  <div class="page-head">
    <div>
      <p class="eyebrow">At the gate</p>
      <h1 class="page-head__title">Scan to tap in</h1>
    </div>
    <p class="page-head__meta"><b id="scan-count">{checkedInCount}</b> in tonight</p>
  </div>

  {
    !ready ? (
      <p class="empty">Connect the database first — see the Overview tab.</p>
    ) : (
      <>
        <div class="days" role="group" aria-label="Which night">
          {convention.days.map((day) => (
            <a
              href={`/admin/scan?day=${encodeURIComponent(day.label)}`}
              class:list={["day", day.label === selectedDay && "day--on"]}
            >
              {day.label}
              {day.label === today && <small>tonight</small>}
            </a>
          ))}
        </div>

        <div class="scanner" data-day={selectedDay}>
          <div class="viewport" id="viewport">
            <video id="video" playsinline webkit-playsinline muted autoplay></video>
            <div class="reticle" aria-hidden="true"></div>
            <p class="viewport__idle" id="viewport-idle">Camera is off</p>
          </div>

          <div class="controls">
            <button type="button" class="btn btn--primary" id="scan-toggle">Start camera</button>
            <button type="button" class="btn" id="flip-camera" hidden>Flip camera</button>
          </div>

          <p class="status" id="status" role="status" aria-live="polite">
            Point the camera at the pass. It checks in automatically.
          </p>

          <form class="manual" id="manual-form">
            <label for="manual-code">Or type the code</label>
            <div class="manual__row">
              <input
                type="text"
                id="manual-code"
                name="code"
                placeholder="e.g. K7M2QP"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                maxlength="6"
              />
              <button type="submit" class="btn btn--primary">Check in</button>
            </div>
          </form>
        </div>

        <ul class="log" id="log" aria-label="Recently scanned"></ul>
      </>
    )
  }
</Admin>

<script>
  import { createDecoder, openCamera, cameraErrorMessage } from "../../lib/scanner";

  const scanner = document.querySelector<HTMLElement>(".scanner");
  const video = document.getElementById("video") as HTMLVideoElement | null;
  const toggle = document.getElementById("scan-toggle") as HTMLButtonElement | null;
  const flip = document.getElementById("flip-camera") as HTMLButtonElement | null;
  const status = document.getElementById("status");
  const idle = document.getElementById("viewport-idle");
  const counter = document.getElementById("scan-count");
  const log = document.getElementById("log");
  const manualForm = document.getElementById("manual-form") as HTMLFormElement | null;
  const manualInput = document.getElementById("manual-code") as HTMLInputElement | null;

  if (scanner && video && toggle && status && log) {
    const day = scanner.dataset.day!;
    const decoder = createDecoder();

    let stream: MediaStream | null = null;
    let running = false;
    let facing: "environment" | "user" = "environment";
    let timer = 0;

    // The same pass stays in frame for many frames; ignore repeats briefly.
    const recentlySeen = new Map<string, number>();
    const COOLDOWN_MS = 4000;

    // jsQR decodes on the main thread, so poll rather than tying it to the
    // frame rate — 10/sec is plenty for a person holding up a phone, and
    // leaves the UI responsive on an older handset.
    const INTERVAL_MS = decoder.engine === "native" ? 120 : 220;

    const setStatus = (message: string, tone: "" | "ok" | "warn" | "bad" = "") => {
      status.textContent = message;
      status.className = tone ? `status status--${tone}` : "status";
    };

    const beep = (good: boolean) => {
      try {
        const Ctx = (window as any).AudioContext ?? (window as any).webkitAudioContext;
        const context = new Ctx();
        const osc = context.createOscillator();
        const gain = context.createGain();
        osc.frequency.value = good ? 880 : 220;
        gain.gain.value = 0.06;
        osc.connect(gain).connect(context.destination);
        osc.start();
        setTimeout(() => {
          osc.stop();
          context.close();
        }, good ? 120 : 260);
      } catch {
        /* iOS mutes audio until a gesture — the on-screen result still shows */
      }
      if (navigator.vibrate) navigator.vibrate(good ? 60 : [60, 60, 60]);
    };

    const addToLog = (name: string, note: string, tone: string) => {
      const item = document.createElement("li");
      item.className = `log__item log__item--${tone}`;
      item.innerHTML = "<b></b><span></span><time></time>";
      item.querySelector("b")!.textContent = name;
      item.querySelector("span")!.textContent = note;
      item.querySelector("time")!.textContent = new Date().toLocaleTimeString("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
      });
      log.prepend(item);
      while (log.children.length > 12) log.lastElementChild?.remove();
    };

    const submit = async (scanned: string) => {
      const now = Date.now();
      const last = recentlySeen.get(scanned);
      if (last && now - last < COOLDOWN_MS) return;
      recentlySeen.set(scanned, now);

      setStatus("Checking…");

      try {
        const response = await fetch("/api/checkin", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ scanned, dayLabel: day }),
        });
        const result = await response.json();

        if (!response.ok) {
          setStatus(result.error ?? "That didn’t work.", "bad");
          addToLog(scanned.slice(-6), result.error ?? "Rejected", "bad");
          beep(false);
          return;
        }

        if (result.alreadyCheckedIn) {
          setStatus(`${result.name} is already in tonight.`, "warn");
          addToLog(result.name, "Already checked in", "warn");
          beep(false);
          return;
        }

        setStatus(
          `${result.name} — in.${result.partySize > 1 ? ` Party of ${result.partySize}.` : ""}`,
          "ok",
        );
        addToLog(
          result.name,
          `Checked in${result.partySize > 1 ? ` · ${result.partySize} people` : ""}`,
          "ok",
        );
        beep(true);
        if (counter) counter.textContent = String(Number(counter.textContent) + 1);
      } catch {
        setStatus("No connection. The code is still valid — try again.", "bad");
        beep(false);
      }
    };

    const stop = () => {
      running = false;
      clearInterval(timer);
      stream?.getTracks().forEach((track) => track.stop());
      stream = null;
      video.srcObject = null;
      scanner.classList.remove("is-live");
      toggle.textContent = "Start camera";
      flip?.setAttribute("hidden", "");
      if (idle) idle.hidden = false;
    };

    const tick = async () => {
      if (!running || video.readyState < 2) return;
      const value = await decoder.decode(video);
      if (value) await submit(value);
    };

    const start = async () => {
      try {
        stream = await openCamera(facing);
        video.srcObject = stream;

        // iOS can reject play() if the gesture has already been consumed;
        // the stream is still live, so carry on rather than failing the scan.
        try {
          await video.play();
        } catch {
          /* autoplay attribute usually covers it */
        }

        running = true;
        scanner.classList.add("is-live");
        toggle.textContent = "Stop camera";
        flip?.removeAttribute("hidden");
        if (idle) idle.hidden = true;
        setStatus("Ready — hold the pass in the frame.");

        clearInterval(timer);
        timer = window.setInterval(tick, INTERVAL_MS);
      } catch (error) {
        setStatus(cameraErrorMessage(error), "bad");
        manualInput?.focus();
      }
    };

    toggle.addEventListener("click", () => (running ? stop() : start()));

    flip?.addEventListener("click", async () => {
      facing = facing === "environment" ? "user" : "environment";
      stop();
      await start();
    });

    // Release the camera when the tab is hidden — otherwise the phone runs hot
    // in an usher's pocket between arrivals.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && running) stop();
    });

    manualForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = manualInput?.value.trim();
      if (!value) return;
      submit(value);
      manualForm.reset();
      manualInput?.focus();
    });
  }
</script>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .page-head__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: var(--space-1) 0 0;
  }

  .page-head__meta {
    font-size: var(--text-sm);
    color: var(--color-ink-mute);
    margin: 0;
  }

  .page-head__meta b {
    font-size: var(--text-xl);
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .days {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .day {
    border: 1px solid var(--color-line);
    color: var(--color-ink-mute);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .day--on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .day small {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .scanner {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    max-width: 34rem;
  }

  .viewport {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #0b0d1a;
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .viewport video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .scanner.is-live .viewport video {
    display: block;
  }

  .viewport__idle {
    position: absolute;
    color: #99a1bd;
    font-size: var(--text-sm);
    margin: 0;
  }

  .reticle {
    position: absolute;
    width: 56%;
    aspect-ratio: 1;
    border: 2px solid var(--accent);
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
  }

  .scanner.is-live .reticle {
    opacity: 0.9;
  }

  .controls {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .btn {
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-4);
    min-height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .status {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-mute);
    min-height: 1.5em;
  }

  .status--ok {
    color: var(--color-success);
  }

  .status--warn {
    color: var(--color-warning);
  }

  .status--bad {
    color: var(--color-danger);
  }

  .manual {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .manual label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin-bottom: var(--space-2);
  }

  .manual__row {
    display: flex;
    gap: var(--space-2);
  }

  .manual input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .manual input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: var(--accent);
  }

  .log {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    max-width: 34rem;
  }

  .log :global(.log__item) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .log :global(.log__item b) {
    color: var(--color-ink);
  }

  .log :global(.log__item span) {
    color: var(--color-ink-mute);
    font-size: var(--text-xs);
  }

  .log :global(.log__item--ok span) {
    color: var(--color-success);
  }

  .log :global(.log__item--warn span) {
    color: var(--color-warning);
  }

  .log :global(.log__item--bad span) {
    color: var(--color-danger);
  }

  .log :global(.log__item time) {
    color: var(--color-ink-mute);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    color: var(--color-ink-mute);
  }
</style>
