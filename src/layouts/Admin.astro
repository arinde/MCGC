---
import Base from "./Base.astro";
import Brand from "../components/Brand.astro";
import "../styles/table.css";

interface Props {
  title: string;
  active: "overview" | "scan" | "checkin" | "counts" | "volunteers";
}

const { title, active } = Astro.props;

const tabs = [
  { key: "overview", href: "/admin", label: "Overview" },
  { key: "scan", href: "/admin/scan", label: "Scan" },
  { key: "checkin", href: "/admin/checkin", label: "Search" },
  { key: "counts", href: "/admin/counts", label: "Headcounts" },
  { key: "volunteers", href: "/admin/volunteers", label: "Volunteers" },
] as const;
---

<Base title={`${title} · Majiyagbe Admin`} noindex>
  <div class="admin-root">
    <header class="admin-bar">
      <div class="admin-bar__inner">
        <Brand href="/admin" compact />
        <span class="admin-bar__label">Convention admin</span>

        <nav class="admin-bar__tabs" aria-label="Dashboard sections">
          {
            tabs.map((tab) => (
              <a href={tab.href} aria-current={active === tab.key ? "page" : undefined}>
                {tab.label}
              </a>
            ))
          }
        </nav>

        <form method="POST" action="/admin/logout">
          <button type="submit" class="admin-bar__signout">Sign out</button>
        </form>
      </div>
    </header>

    <main id="main" class="admin-main">
      <slot />
    </main>
  </div>
</Base>

<style is:global>
  /**
   * The dashboard is a light surface (design system §5). Rather than restyling
   * every admin component, remap the semantic tokens here — components keep
   * referencing `--surface`, `--text` and `--rule`, and simply resolve light.
   *
   * `--font-display` is remapped to the body face on purpose: no Fraunces in
   * the dashboard, per §5.
   */
  .admin-root {
    --surface-deep: var(--color-canvas);
    --surface: var(--color-surface);
    --surface-raised: var(--color-canvas);

    --text: var(--color-ink);
    --text-muted: var(--color-ink-mute);

    --rule: var(--color-line);
    --rule-strong: #cfc8bd;

    --font-display: var(--font-body);

    background: var(--color-canvas);
    color: var(--color-ink);
    min-height: 100dvh;
  }

  /* Base paints the public site's night ground on <body>; the dashboard needs
     the light canvas behind it instead. */
  body:has(.admin-root) {
    background: var(--color-canvas);
    color: var(--color-ink);
  }
</style>

<style>
  .admin-bar {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .admin-bar__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2);
  }

  .admin-bar__label {
    display: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  /* The tab strip drops to its own scrollable row on a phone, so an usher can
     reach Scan and Search without the bar collapsing into two cramped lines. */
  .admin-bar__tabs {
    grid-column: 1 / -1;
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .admin-bar__tabs::-webkit-scrollbar {
    display: none;
  }

  .admin-bar__tabs a {
    flex: 0 0 auto;
  }

  .admin-bar__tabs a {
    color: var(--color-ink-mute);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .admin-bar__tabs a:hover {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .admin-bar__tabs a[aria-current="page"] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .admin-bar__signout {
    background: none;
    border: 1px solid var(--color-line);
    color: var(--color-ink-mute);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .admin-bar__signout:hover {
    border-color: var(--color-ink-mute);
    color: var(--color-ink);
  }

  .admin-main {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4) var(--space-24);
  }

  @media (min-width: 760px) {
    .admin-bar__inner {
      padding: 0 var(--space-6);
      grid-template-columns: auto auto 1fr auto;
      min-height: 56px;
    }

    .admin-bar__label {
      display: block;
    }

    .admin-bar__tabs {
      grid-column: auto;
      justify-self: end;
    }

    .admin-main {
      padding: var(--space-8) var(--space-6) var(--space-24);
    }
  }
</style>
