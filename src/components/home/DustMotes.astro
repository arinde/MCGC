---
/**
 * Slow-drifting motes in the light shafts. Purely atmospheric — canvas is
 * hidden from assistive tech, skipped entirely under reduced-motion, and
 * paused when the tab is in the background.
 */
---

<canvas id="motes" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("motes") as HTMLCanvasElement | null;
  const context = canvas?.getContext("2d");
  const parent = canvas?.parentElement;

  if (canvas && context && parent && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    // Cap the pixel ratio: on a 3× phone the extra fidelity is invisible here
    // but the fill cost is real.
    const scale = Math.min(devicePixelRatio || 1, 2);

    type Mote = { x: number; y: number; r: number; vx: number; vy: number; alpha: number; phase: number };

    let width = 0;
    let height = 0;
    let motes: Mote[] = [];
    let frame = 0;

    const resize = () => {
      const box = parent.getBoundingClientRect();
      width = canvas.width = Math.max(1, Math.round(box.width * scale));
      height = canvas.height = Math.max(1, Math.round(box.height * scale));

      const count = Math.round(Math.min(90, box.width / 12));
      motes = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: (Math.random() * 1.5 + 0.4) * scale,
        vx: (Math.random() - 0.5) * 0.16 * scale,
        vy: -(Math.random() * 0.22 + 0.05) * scale,
        alpha: Math.random() * 0.45 + 0.12,
        phase: Math.random() * Math.PI * 2,
      }));
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);

      for (const mote of motes) {
        mote.phase += 0.008;
        mote.y += mote.vy;
        mote.x += mote.vx + Math.sin(mote.phase) * 0.18 * scale;

        // Wrap around rather than respawning, so density stays constant.
        if (mote.y < -6) {
          mote.y = height + 6;
          mote.x = Math.random() * width;
        }
        if (mote.x < -6) mote.x = width + 6;
        if (mote.x > width + 6) mote.x = -6;

        const flicker = mote.alpha * (0.6 + 0.4 * Math.sin(mote.phase));
        context.beginPath();
        context.arc(mote.x, mote.y, mote.r, 0, Math.PI * 2);
        context.fillStyle = `rgba(247, 214, 147, ${flicker.toFixed(3)})`;
        context.fill();
      }

      frame = requestAnimationFrame(draw);
    };

    resize();
    frame = requestAnimationFrame(draw);

    let resizeTimer: ReturnType<typeof setTimeout>;
    addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 180);
    });

    document.addEventListener("visibilitychange", () => {
      cancelAnimationFrame(frame);
      if (!document.hidden) frame = requestAnimationFrame(draw);
    });
  }
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
