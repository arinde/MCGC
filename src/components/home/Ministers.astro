---
import { convention, type Minister } from "../../data/convention";

const { ministers } = convention;

/** Falls back to initials in a gold roundel when no photo has been supplied yet. */
function initials(name: Minister["name"]): string {
  return name
    .split(/\s+/)
    .filter((word) => /[A-Za-z]/.test(word))
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join("");
}
---

<section class="band" id="ministers">
  <div class="wrap">
    <div class="head rv">
      <p class="eyebrow">Ministering</p>
      <h2 class="display">Who is coming to serve us.</h2>
      <p class="lede">
        Guest ministers, our own pastorate and the convention choir &mdash; each carrying a piece
        of the week.
      </p>
    </div>

    <div class="people rv">
      {
        ministers.map((minister) => (
          <article class="person">
            <div class="person__mark">
              {minister.photo ? (
                <img src={minister.photo} alt={minister.name} width="64" height="64" loading="lazy" />
              ) : (
                initials(minister.name)
              )}
            </div>
            <h3>{minister.name}</h3>
            <p class="person__role">{minister.role}</p>
            {minister.org && <p class="person__org">{minister.org}</p>}
            <p class="person__slots">{minister.slots}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .people {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }

  .person {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 24px;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .person:hover {
    border-color: var(--accent-deep);
    transform: translateY(-3px);
  }

  .person__mark {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.35rem;
    color: var(--accent);
    background: var(--surface-raised);
    border: 1px solid var(--accent-deep);
    margin-bottom: 18px;
    overflow: hidden;
  }

  .person__mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person h3 {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .person__role {
    margin: 5px 0 0;
    font-size: 0.83rem;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .person__org {
    margin: 9px 0 0;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .person__slots {
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
