---
import RegisterForm from "./RegisterForm.astro";

const reasons = [
  {
    title: "We save you a seat",
    detail: "Numbers go to the ushering team the morning of each night.",
  },
  {
    title: "Children are catered for",
    detail: "Tell us you’re bringing them and the children’s church plans around it.",
  },
  {
    title: "You get the reminders",
    detail: "A short message the day before, and nothing else. We don’t share your details.",
  },
];
---

<section class="band register" id="register">
  <div class="wrap">
    <div class="head rv">
      <p class="eyebrow">Registration</p>
      <h2 class="display">Tell us you&rsquo;re coming.</h2>
      <p class="lede">
        Registration is free. It simply helps us set out enough seats, print enough handouts and
        plan the children&rsquo;s programme.
      </p>
    </div>

    <div class="register__grid">
      <div class="rv">
        <ol class="reasons">
          {
            reasons.map((reason, index) => (
              <li>
                <span class="reasons__number">{index + 1}</span>
                <span>
                  <strong>{reason.title}</strong>
                  <em>{reason.detail}</em>
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="rv">
        <RegisterForm />
      </div>
    </div>
  </div>
</section>

<style>
  .register {
    background: var(--ink-2);
  }

  .register__grid {
    display: grid;
    gap: clamp(30px, 5vw, 56px);
  }

  .reasons {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
    counter-reset: none;
  }

  .reasons li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }

  /* Numbered because these are the three things that happen, in order,
     once someone registers — not decoration. */
  .reasons__number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.95rem;
    color: var(--gold);
    border: 1px solid var(--gold-deep);
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
  }

  .reasons strong {
    display: block;
    font-size: 0.98rem;
  }

  .reasons em {
    font-style: normal;
    color: var(--dim);
    font-size: 0.87rem;
  }

  @media (min-width: 940px) {
    .register__grid {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }
  }
</style>
