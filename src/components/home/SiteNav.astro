---
import Button from "../Button.astro";

const links = [
  { href: "#about", label: "The Convention" },
  { href: "#schedule", label: "Schedule" },
  { href: "#ministers", label: "Ministering" },
  { href: "#venue", label: "Venue" },
];
---

<nav class="nav" id="nav" aria-label="Main">
  <div class="wrap nav__inner">
    <a class="mark" href="#top">MC<span>G</span>C</a>

    <ul class="nav__links">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    <Button href="#register" size="sm" class="nav__cta">Register free</Button>
  </div>
</nav>

<script>
  // Border appears only once the page has scrolled, so the nav sits flush
  // against the hero at rest.
  const nav = document.getElementById("nav");
  if (nav) {
    const update = () => nav.classList.toggle("is-stuck", window.scrollY > 12);
    update();
    addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(11, 13, 26, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }

  .nav.is-stuck {
    border-bottom-color: var(--line-soft);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 64px;
  }

  .mark {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.12rem;
    letter-spacing: 0.04em;
    color: var(--halo);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .mark span {
    color: var(--gold);
  }

  .nav__links {
    display: none;
    gap: 26px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .nav__links a {
    color: var(--dim);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .nav__links a:hover {
    color: var(--halo);
  }

  .nav :global(.nav__cta) {
    margin-left: auto;
  }

  @media (min-width: 880px) {
    .nav__links {
      display: flex;
    }

    .nav :global(.nav__cta) {
      margin-left: 26px;
    }
  }
</style>
