---
import Button from "../Button.astro";
import Brand from "../Brand.astro";

/**
 * Below 880px the links collapse behind a menu button. Most traffic here is
 * mobile, so that is the primary layout, not an afterthought.
 *
 * Links are absolute ("/#schedule", not "#schedule") so the nav also works
 * from /volunteer and /pass/*, where a bare hash would go nowhere.
 */
const links = [
  { href: "/#schedule", label: "Schedule" },
  { href: "/#checklist", label: "What to bring" },
  { href: "/#ministers", label: "Ministering" },
  { href: "/#venue", label: "Venue" },
  { href: "/volunteer", label: "Join the team" },
];
---

<nav class="nav" id="nav" aria-label="Main">
  <div class="wrap nav__inner">
    <Brand href="/" />

    <button
      type="button"
      class="nav__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="sr-only">Menu</span>
    </button>

    <div class="nav__menu" id="nav-menu">
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <Button href="/#register" size="sm" class="nav__cta">Register</Button>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  if (nav && toggle && menu) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Tapping a link closes the menu and lets the anchor scroll happen.
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (!nav.contains(event.target as Node)) setOpen(false);
    });

    // Growing past the breakpoint with the menu open would strand the state.
    matchMedia("(min-width: 880px)").addEventListener("change", () => setOpen(false));

    const shadow = () => nav.classList.toggle("is-stuck", window.scrollY > 12);
    shadow();
    addEventListener("scroll", shadow, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgb(11 13 26 / 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base) var(--ease);
  }

  .nav.is-stuck {
    border-bottom-color: var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 60px;
  }

  .nav__toggle {
    margin-left: auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav__bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .nav__bars i {
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition:
      transform var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .nav.is-open .nav__bars i:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav.is-open .nav__bars i:nth-child(2) {
    opacity: 0;
  }

  .nav.is-open .nav__bars i:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav__menu {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--surface);
    border-block: 1px solid var(--rule);
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .nav.is-open .nav__menu {
    display: block;
  }

  .nav__links {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
  }

  .nav__links a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 600;
    border-bottom: 1px solid var(--rule);
  }

  .nav__links a:hover {
    color: var(--accent);
  }

  .nav :global(.nav__cta) {
    width: 100%;
  }

  @media (min-width: 880px) {
    .nav__toggle {
      display: none;
    }

    .nav__menu {
      display: flex;
      position: static;
      align-items: center;
      gap: var(--space-6);
      margin-left: auto;
      background: none;
      border: 0;
      padding: 0;
    }

    .nav__links {
      display: flex;
      gap: var(--space-6);
      margin: 0;
    }

    .nav__links a {
      min-height: 44px;
      font-size: var(--text-sm);
      color: var(--text-muted);
      border-bottom: 0;
    }

    .nav :global(.nav__cta) {
      width: auto;
    }
  }
</style>
