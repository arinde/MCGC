---
import { convention } from "../../data/convention";
import Button from "../Button.astro";

const { title, year, theme, verse, verseRef, datesLabel, venue } = convention;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue.maps)}`;
---

<header class="hero" id="top">
  <!-- The one light source on the page: the flyer's portal of daylight
       breaking through oxblood. Nothing else on the site glows. -->
  <div class="hero__bloom" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <p class="eyebrow">{title} · {year}</p>

    <div class="hero__lockup">
      <p class="hero__theme-label">Theme</p>
      <h1 class="display hero__theme">
        {theme.map((line, index) => <>{index > 0 && <br />}{line}</>)}
      </h1>
      <p class="hero__ref">{verseRef}</p>
    </div>

    <blockquote class="hero__verse">&ldquo;{verse}&rdquo;</blockquote>

    <dl class="hero__when">
      <div>
        <dt>When</dt>
        <dd>{datesLabel}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>{venue.name}<span>{venue.address}</span></dd>
      </div>
    </dl>

    <div class="hero__actions">
      <Button href={mapsUrl} external>Get directions</Button>
      <Button href="#schedule" variant="ghost">See the schedule</Button>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    padding-block: var(--space-12) var(--space-16);
  }

  .hero__bloom {
    position: absolute;
    left: 50%;
    top: -14%;
    transform: translateX(-50%);
    width: min(940px, 150vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 45%,
      var(--glow-cool-pale) 0%,
      var(--glow-cool) 16%,
      var(--glow-warm) 42%,
      transparent 68%
    );
    opacity: 0.34;
    filter: blur(12px);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* The arch: echoes the portal and a church window. Used here and on the
     minister portraits — nowhere else. */
  .hero__lockup {
    margin: var(--space-6) 0 var(--space-8);
    padding: var(--space-8) var(--space-6) var(--space-6);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-arch);
    background: linear-gradient(to bottom, rgb(11 13 26 / 0.6), rgb(11 13 26 / 0.15));
    text-align: center;
    max-width: 34rem;
  }

  .hero__theme-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }

  .hero__theme {
    font-size: var(--text-3xl);
    color: var(--accent);
    font-variation-settings: "SOFT" 40, "WONK" 1;
  }

  .hero__ref {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    margin: var(--space-4) 0 0;
  }

  .hero__verse {
    margin: 0 0 var(--space-8);
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent-deep);
    font-size: var(--text-base);
    color: var(--text);
    max-width: var(--measure);
  }

  .hero__when {
    display: grid;
    gap: var(--space-6);
    margin: 0 0 var(--space-8);
  }

  .hero__when dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .hero__when dd {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }

  .hero__when dd span {
    display: block;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-muted);
    margin-top: var(--space-1);
    max-width: 38ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .hero__when {
      grid-template-columns: auto 1fr;
      gap: var(--space-12);
    }
  }
</style>
