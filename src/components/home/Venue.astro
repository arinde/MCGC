---
import { convention } from "../../data/convention";
import Button from "../Button.astro";
import VenueMap from "./VenueMap.astro";

const { venue } = convention;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue.maps)}`;
---

<section class="band" id="venue">
  <div class="wrap">
    <div class="head rv">
      <p class="eyebrow">Getting there</p>
      <h2 class="display">Where we&rsquo;re meeting.</h2>
    </div>

    <div class="venue">
      <div class="rv">
        <VenueMap />
      </div>

      <div class="rv">
        <p class="venue__address">
          <strong>{venue.name}</strong>
          {venue.address}
          {venue.landmark && <span class="venue__landmark">{venue.landmark}</span>}
        </p>

        <ul class="venue__notes">
          {
            venue.getting.map((line) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                <span>{line}</span>
              </li>
            ))
          }
        </ul>

        <div class="venue__cta">
          <Button href={mapsUrl} external>Open in Google Maps</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .venue {
    display: grid;
    gap: clamp(28px, 5vw, 50px);
  }

  .venue__address {
    font-size: 1.06rem;
    line-height: 1.7;
    margin: 0;
  }

  .venue__address strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .venue__landmark {
    display: block;
    color: var(--dim);
    font-size: 0.92rem;
  }

  .venue__notes {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .venue__notes li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    font-size: 0.92rem;
    color: var(--dim);
  }

  .venue__notes svg {
    width: 18px;
    height: 18px;
    color: var(--gold);
    margin-top: 3px;
  }

  .venue__cta {
    margin-top: 28px;
  }

  @media (min-width: 900px) {
    .venue {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
