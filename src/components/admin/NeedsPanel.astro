---
import Panel from "./Panel.astro";
import type { FlagRow } from "../../lib/stats";

/**
 * What people asked for when they registered, and who has to act on it.
 *
 * Every row links straight to the filtered register, because a count of 14
 * people needing transport is useless to the logistics team without the
 * fourteen names and phone numbers behind it.
 */

interface Props {
  flags: FlagRow[];
  totalParties: number;
}

const { flags, totalParties } = Astro.props;

const percent = new Intl.NumberFormat("en-GB", {
  style: "percent",
  maximumFractionDigits: 0,
});
---

<Panel
  title="Declared needs"
  hint="What people asked for on the form. Open a list to get the names and numbers."
>
  {
    totalParties === 0 ? (
      <p class="empty">No registrations yet.</p>
    ) : (
      <ul class="needs">
        {flags.map((flag) => (
          <li class="need">
            <div class="need__head">
              <p class="need__label">{flag.label}</p>
              <p class="need__team">{flag.team}</p>
            </div>

            <div class="need__figures">
              <span class="need__value">{flag.parties}</span>
              <span class="need__unit">
                {flag.parties === 1 ? "booking" : "bookings"} · {flag.people} people
              </span>
            </div>

            <div class="need__meter" aria-hidden="true">
              <span class="need__fill" style={`width:${Math.max(flag.share * 100, flag.parties > 0 ? 2 : 0)}%`} />
            </div>

            <p class="need__share">{percent.format(flag.share)}</p>

            <a class="need__link" href={`/admin/people?flag=${encodeURIComponent(flag.id)}`}>
              View list<span class="sr-only"> of people who need {flag.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Panel>

<style>
  .needs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .need {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .need:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .need__label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .need__team {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 2px 0 0;
  }

  .need__figures {
    text-align: right;
  }

  .need__value {
    display: block;
    font-size: var(--text-lg);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    line-height: 1.1;
  }

  .need__unit {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .need__meter {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: 999px;
    background: var(--rule);
    overflow: hidden;
  }

  .need__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--accent);
  }

  .need__share {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .need__link {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-info);
    text-decoration: none;
    justify-self: end;
  }

  .need__link:hover {
    text-decoration: underline;
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
