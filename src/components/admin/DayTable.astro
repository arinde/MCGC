---
import type { DayRow } from "../../lib/stats";

interface Props {
  days: DayRow[];
}

const { days } = Astro.props;

/** Bar width is relative to the busiest night, so the shape is readable at any scale. */
const peak = Math.max(1, ...days.map((day) => Math.max(day.registeredPeople, day.attendedPeople)));

function turnoutLabel(turnout: number | null): string {
  return turnout === null ? "—" : `${Math.round(turnout * 100)}%`;
}

function turnoutState(turnout: number | null): string {
  if (turnout === null) return "none";
  if (turnout >= 0.8) return "good";
  if (turnout >= 0.5) return "warn";
  return "bad";
}
---

<div class="panel">
  <h2 class="panel__title">Night by night</h2>

  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Night</th>
          <th scope="col" class="num">Registered</th>
          <th scope="col" class="num">Attended</th>
          <th scope="col">Turnout</th>
          <th scope="col" class="col-bar"><span class="sr-only">Comparison</span></th>
        </tr>
      </thead>
      <tbody>
        {
          days.map((day) => (
            <tr>
              <th scope="row">{day.label}</th>
              <td data-label="Registered" class="num">
                {day.registeredPeople}
                <span class="sub">{day.registeredParties} bookings</span>
              </td>
              <td data-label="Attended" class="num">
                {day.attendedPeople || "—"}
                {day.attendedParties > 0 && <span class="sub">{day.attendedParties} checked in</span>}
              </td>
              <td data-label="Turnout">
                <span class:list={["pill", `pill--${turnoutState(day.turnout)}`]}>
                  {turnoutLabel(day.turnout)}
                </span>
              </td>
              <td class="col-bar" data-label="Comparison">
                <span class="bar bar--registered" style={`width:${(day.registeredPeople / peak) * 100}%`} />
                <span class="bar bar--attended" style={`width:${(day.attendedPeople / peak) * 100}%`} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="legend">
    <span class="key key--registered"></span> Registered
    <span class="key key--attended"></span> Actually attended
  </p>
</div>

<style>
  .panel {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
    margin: 0 0 18px;
  }

  .pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    border: 1px solid;
  }

  .pill--good {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  .pill--warn {
    color: var(--color-warning);
    border-color: var(--accent-deep);
  }

  .pill--bad {
    color: var(--color-danger);
    border-color: var(--color-danger);
  }

  .pill--none {
    color: var(--text-muted);
    border-color: var(--rule-strong);
  }

  .col-bar {
    width: 34%;
    min-width: 120px;
  }

  .bar {
    display: block;
    height: 8px;
    border-radius: 999px;
    min-width: 2px;
  }

  .bar--registered {
    background: var(--accent-deep);
    margin-bottom: 4px;
  }

  .bar--attended {
    background: var(--accent);
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    color: var(--text-muted);
    margin: 16px 0 0;
  }

  .key {
    width: 14px;
    height: 8px;
    border-radius: 999px;
    display: inline-block;
  }

  .key--registered {
    background: var(--accent-deep);
  }

  .key--attended {
    background: var(--accent);
    margin-left: 10px;
  }
</style>
